{
  "name": "stackfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A private digital investment and recurring cost tracker.",
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:app && npm --workspace api run build",
    "build:app": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && npm --workspace api run typecheck",
    "test": "npm --workspace api test"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
