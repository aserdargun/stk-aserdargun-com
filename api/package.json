{
  "name": "stackfolio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/data && cp ../data/seed-data.json dist/data/seed-data.json && cp ../data/card-digital-services.json dist/data/card-digital-services.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.2",
    "pdfjs-dist": "6.3.289",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
